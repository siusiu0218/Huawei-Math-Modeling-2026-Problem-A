# This repository tracks the A problem only.
/*
!/A题/
!/.gitignore

# Keep the A problem input data locally.
/A题/data/

# Local Python artifacts inside A题.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local full run records and ZIP archives are too large for the Git remote.
/A题/solution/outputs/*/raw/
/A题/solution/outputs/**/*.zip
/A题/solution/outputs/*.zip
/A题/solution/results/
/A题/solution/outputs/90_*
